# Local development. Set NODE_ENV=production and a unique JWT_SECRET on Render.
PORT=8000
NODE_ENV=development
FRONTEND_ORIGIN=http://localhost:3000
# JWT_SECRET must be a unique random value of at least 32 characters in production.
# JWT_SECRET=your-generated-secret
COOKIE_SECURE=false

NEO4J_URI=neo4j+s://your-instance.databases.neo4j.io
NEO4J_USERNAME=neo4j
NEO4J_PASSWORD=replace-with-your-neo4j-password
NEO4J_DATABASE=neo4j
